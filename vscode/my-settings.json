{
	"editor.suggestSelection": "first",
	"editor.formatOnSave": true,
	"editor.linkedEditing": true,
	"security.workspace.trust.untrustedFiles": "open",
	"editor.stickyScroll.enabled": false,
	"git.autofetch": true,
	"git.confirmSync": false,
	"editor.fontSize": 14,
	"js/ts.updateImportsOnFileMove.enabled": "always",
	"diffEditor.ignoreTrimWhitespace": true,
	"workbench.preferredDarkColorTheme": "Visual Studio Dark",
	"workbench.editor.showTabs": "multiple",
	"editor.codeActionsOnSave": {
		"source.organizeImports.biome": "explicit",
		"source.fixAll.biome": "explicit"
	},
	"github.copilot.enable": {
		"*": true,
		"plaintext": false,
		"markdown": false,
		"scminput": false,
		"typescript": true,
		"typescriptreact": true,
		"python": true
	},
	"workbench.externalBrowser": "chrome",
	"[prisma]": {
		"editor.formatOnSave": true
	},
	"[javascript][javascriptreact][typescript][typescriptreact][jsonc][html]": {
		"editor.defaultFormatter": "biomejs.biome"
	},
	"[json]": {
		"editor.defaultFormatter": "vscode.json-language-features"
	},
	"[python]": {
		"editor.defaultFormatter": "charliermarsh.ruff",
		"editor.codeActionsOnSave": {
			"source.organizeImports.ruff": "explicit",
			"source.fixAll.ruff": "explicit"
		}
	},
	"notebook.codeActionsOnSave": {
		"notebook.source.organizeImports.ruff": "explicit",
		"notebook.source.fixAll.ruff": "explicit"
	},
	"python.analysis.typeCheckingMode": "standard",
	"[rust]": {
		"editor.defaultFormatter": "rust-lang.rust-analyzer"
	},
	"rust-analyzer.check.command": "clippy",
	"explorer.compactFolders": false,
	"editor.renderLineHighlight": "gutter",
	"editor.semanticHighlighting.enabled": false,
	"workbench.tree.enableStickyScroll": false,
	"github.copilot.nextEditSuggestions.enabled": false,
	"workbench.secondarySideBar.defaultVisibility": "hidden",
	"workbench.navigationControl.enabled": false,
	"claudeCode.preferredLocation": "panel",
	"notebook.formatOnSave.enabled": true,
	"json.schemaDownload.trustedDomains": {
		"https://schemastore.azurewebsites.net/": true,
		"https://raw.githubusercontent.com/": true,
		"https://www.schemastore.org/": true,
		"https://json.schemastore.org/": true,
		"https://json-schema.org/": true,
		"https://biomejs.dev": true
	},
	"workbench.colorTheme": "Dark Modern",
	"workbench.editorLargeFileConfirmation": 1000,
	"workbench.browser.openLocalhostLinks": false,
	"chat.viewSessions.orientation": "stacked",
	"terminal.integrated.mouseWheelScrollSensitivity": 3,
	"terminal.integrated.gpuAcceleration": "off",
	"vim.useSystemClipboard": true,
	"vim.useCtrlKeys": false,
	"vim.visualModeKeyBindingsNonRecursive": [
		{
			"before": ["p"],
			"commands": ["editor.action.clipboardPasteAction"]
		}
	],
	"vim.normalModeKeyBindings": [
		{
			"before": ["d", "f"],
			"after": ["g", "d"]
		}
	],
	"vim.visualModeKeyBindings": [
		{
			"before": [">"],
			"after": [">", "g", "v"]
		},
		{
			"before": ["<"],
			"after": ["<", "g", "v"]
		}
	],
	"chat.titleBar.openInAgentsWindow.enabled": false,
	"diffEditor.hideUnchangedRegions.enabled": true,
	"diffEditor.renderSideBySide": true,
	"diffEditor.useInlineViewWhenSpaceIsLimited": false
}
